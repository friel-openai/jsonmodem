@@ -298,0 +299,65 @@ fn decode_bytes(py: Python<'_>, bytes: &[u8]) -> PyResult<PyObject> {
+/// Accumulates small writes before copying a complete batch to the output Vec.
+struct BufferedOutput {
+    output: Vec<u8>,
+    pending: [u8; 512],
+    used: usize,
+}
+
+impl BufferedOutput {
+    fn new() -> Self {
+        Self {
+            output: Vec::with_capacity(INITIAL_OUTPUT_CAPACITY),
+            pending: [0; 512],
+            used: 0,
+        }
+    }
+
+    fn flush(&mut self) {
+        self.output.extend_from_slice(&self.pending[..self.used]);
+        self.used = 0;
+    }
+
+    fn len(&self) -> usize {
+        self.output.len() + self.used
+    }
+
+    fn push(&mut self, byte: u8) {
+        if self.used == self.pending.len() {
+            self.flush();
+        }
+        self.pending[self.used] = byte;
+        self.used += 1;
+    }
+
+    fn extend_from_slice(&mut self, bytes: &[u8]) {
+        if bytes.len() > self.pending.len() - self.used {
+            self.flush();
+        }
+        if bytes.len() >= self.pending.len() {
+            self.output.extend_from_slice(bytes);
+        } else {
+            self.pending[self.used..self.used + bytes.len()].copy_from_slice(bytes);
+            self.used += bytes.len();
+        }
+    }
+
+    fn reserve(&mut self, additional: usize) {
+        self.output.reserve(self.used + additional);
+    }
+
+    fn resize(&mut self, length: usize, byte: u8) {
+        self.flush();
+        self.output.resize(length, byte);
+    }
+
+    fn extend_from_within(&mut self, range: Range<usize>) {
+        self.flush();
+        self.output.extend_from_within(range);
+    }
+
+    fn bytes(&mut self) -> &[u8] {
+        self.flush();
+        &self.output
+    }
+}
+
@@ -301 +366 @@ struct Encoder {
