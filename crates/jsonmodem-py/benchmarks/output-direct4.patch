@@ -328,0 +329,37 @@ impl Encoder {
+    fn integer(&mut self, mut value: u64, negative: bool) {
+        const PAIRS: &[u8; 200] = b"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";
+        let digits = if value == 0 {
+            1
+        } else {
+            value.ilog10() as usize + 1
+        };
+        let start = self.output.len();
+        self.output.resize(start + digits + usize::from(negative), b'0');
+        let output = &mut self.output[start..];
+        let mut cursor = output.len();
+        while value >= 10_000 {
+            let group = (value % 10_000) as usize;
+            value /= 10_000;
+            cursor -= 4;
+            let high = group / 100 * 2;
+            let low = group % 100 * 2;
+            output[cursor..cursor + 2].copy_from_slice(&PAIRS[high..high + 2]);
+            output[cursor + 2..cursor + 4].copy_from_slice(&PAIRS[low..low + 2]);
+        }
+        if value >= 100 {
+            let pair = (value % 100) as usize * 2;
+            value /= 100;
+            cursor -= 2;
+            output[cursor..cursor + 2].copy_from_slice(&PAIRS[pair..pair + 2]);
+        }
+        if value < 10 {
+            output[cursor - 1] = b'0' + value as u8;
+        } else {
+            let pair = value as usize * 2;
+            output[cursor - 2..cursor].copy_from_slice(&PAIRS[pair..pair + 2]);
+        }
+        if negative {
+            output[0] = b'-';
+        }
+    }
+
